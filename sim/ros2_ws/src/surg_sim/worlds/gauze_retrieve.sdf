<?xml version="1.0" ?>
<!-- Same structure as needle_reach.sdf (see that file for the annotated
     version); only the task prop differs: a gauze patch instead of a
     needle. -->
<sdf version="1.9">
  <world name="gauze_retrieve">
    <physics name="1kHz" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz_ros2_control-system" name="gz::sim::systems::ROS2Control"/>

    <light type="directional" name="scialytic_light">
      <pose>0 0 0.4 0 0 0</pose>
      <direction>0 0 -1</direction>
      <diffuse>1 1 1 1</diffuse>
      <intensity>1.5</intensity>
    </light>

    <include>
      <uri>model://tissue_pad</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://psm</uri>
      <pose>0 0 0.2 0 0 0</pose>
      <name>psm</name>
    </include>

    <include>
      <!-- Deformable-cloth gauze model; if your Gazebo build lacks cloth
           sim support, substitute a rigid thin-box placeholder here and
           note it in the run's metadata (affects grasp realism, not
           reach kinematics). -->
      <uri>model://gauze_patch</uri>
      <pose>-0.03 0.04 0.002 0 0 0</pose>
      <name>gauze</name>
    </include>

    <include>
      <uri>model://endoscope_camera</uri>
      <pose>0 0 0.35 0 1.5708 0</pose>
      <name>camera</name>
    </include>
  </world>
</sdf>
