<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>surg_sim</name>
  <version>0.1.0</version>
  <description>
    Gazebo Harmonic + ROS 2 Jazzy simulation of the dVRK PSM for the four
    benchmark tasks (NeedleReach, GauzeRetrieve, PegTransfer, NeedlePick)
    used to evaluate JEPA-based visual inverse kinematics.
    See docs/evaluation_plan.md in the repo root for the full protocol.
  </description>
  <maintainer email="p20250419@pilani.bits-pilani.ac.in">JEPA-IK project</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>ros2_control</depend>
  <depend>ros2_controllers</depend>
  <depend>controller_manager</depend>
  <depend>cv_bridge</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
